CONFIG_IDF_TARGET="esp32c3"

# ESP32-C3-DevKitC-02 Settings
# Buttons
CONFIG_BSP_BUTTONS_NUM=1
CONFIG_BSP_BUTTON_1_TYPE_GPIO=y
CONFIG_BSP_BUTTON_1_GPIO=9
CONFIG_BSP_BUTTON_1_LEVEL=0
# LEDs
CONFIG_BSP_LEDS_NUM=1
CONFIG_BSP_LED_TYPE_RGB=y
CONFIG_BSP_LED_RGB_GPIO=8
CONFIG_BSP_LED_RGB_BACKEND_RMT=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
# CONFIG_COMPILER_ASSERT_NDEBUG_EVALUATE is not set
# CONFIG_ESP_ERR_TO_NAME_LOOKUP is not set
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_HTTPD_MAX_URI_LEN=1024
# CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE is not set
# CONFIG_ESP_PHY_ENABLE_USB is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
# CONFIG_ESP_SYSTEM_MEMPROT_FEATURE is not set
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
# CONFIG_ESP_TASK_WDT_EN is not set
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_MBEDTLS_CRYPTO is not set
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_SUITE_B_192=y
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_11R_SUPPORT=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_HAL_ASSERTION_DISABLE=y
# CONFIG_LOG_COLORS is not set
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_MBEDTLS_CMAC_C=y
# CONFIG_VFS_SUPPORT_IO is not set
CONFIG_MBEDTLS_HKDF_C=y
# CONFIG_ESP_COEX_SW_COEXIST_ENABLE is not set

# CONFIG_ESP_WIFI_MBEDTLS_CRYPTO=y
CONFIG_MBEDTLS_MPI_USE_INTERRUPT=n

CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_ENABLE_CHIPOBLE=n
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_ESP_MATTER_OTA_PROVIDER_ENABLED=n

CONFIG_SUPPORT_FAN_CONTROL_CLUSTER=y
CONFIG_SUPPORT_SWITCH_CLUSTER=y
CONFIG_SUPPORT_TEMPERATURE_CONTROL_CLUSTER=y
CONFIG_SUPPORT_THERMOSTAT_CLUSTER=y
CONFIG_SUPPORT_THERMOSTAT_USER_INTERFACE_CONFIGURATION_CLUSTER=y
